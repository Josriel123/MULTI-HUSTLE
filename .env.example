# Copy to `.env` (NOT .env.local) and fill in. Never commit the filled version.
#
# Why .env: the Prisma CLI reads `.env` only — it does not read `.env.local`.
# Next.js reads both. One `.env` file keeps `prisma db push` and `next dev`
# working off the same values. `.gitignore` already excludes it.

# --- Database (Neon Postgres) ---
# Neon Console -> your project -> Connect. Copy BOTH strings.
#
# Pooled (hostname contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (no "-pooler") — used by `prisma db push` / `prisma migrate`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Clerk auth ---
# https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk -> Webhooks -> add endpoint /api/webhooks/clerk, subscribe to user.created + user.deleted.
# Needed so a User row exists before any tax form or Plaid write (see Phase 1).
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# --- Plaid ---
# https://dashboard.plaid.com -> Developers -> Keys
PLAID_CLIENT_ID="..."
PLAID_SECRET="..."
# sandbox | development | production. Stays "sandbox" for this project.
PLAID_ENV="sandbox"

# --- Encryption ---
# Encrypts Plaid access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
