generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (hostname contains "-pooler") — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection — required by `prisma migrate` / `prisma db push`,
  // which need session-level control the pooler doesn't provide.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  // The Terms of Service and Privacy Policy this user agreed to, and when
  // (src/lib/legal.ts agreementVersion). Null until they tick both boxes in
  // the app's agreement step; a new version asks again. The record is the
  // evidence of a clickwrap agreement, so it is never back-filled.
  agreementVersion    String?
  agreementAcceptedAt DateTime?
  // When they confirmed they are 18 or older. Null means not yet confirmed:
  // the app shows nothing else until they do.
  adultConfirmedAt    DateTime?

  // Federal filing status used by the tax estimate. One of the values in
  // src/lib/tax/types.ts FILING_STATUSES. Defaults to single until the user
  // says otherwise; the estimate reports which status it used.
  filingStatus       String    @default("single")
  // Whether another taxpayer can claim this user as a dependent. Limits the
  // standard deduction (IRC §63(c)(5)) and bars the student loan interest
  // deduction (§221(c)).
  claimedAsDependent Boolean   @default(false)
  // Married filing separately only: the spouse itemizes, so this taxpayer may
  // not take the standard deduction (IRC §63(c)(6)(A)). Read by the engine;
  // ignored for every other filing status.
  spouseItemizes     Boolean   @default(false)
  // When the user last saved the three fields above on the Tax profile page.
  // Null means never: filingStatus then holds the column default, not a
  // choice, and the estimate says it assumed single.
  taxProfileSavedAt  DateTime?

  incomeSources     IncomeSource[]
  transactions      Transaction[]
  plaidConnections  PlaidConnection[]
  mileageLogs       MileageLog[]
  w2Forms           W2Form[]
  estimatedPayments EstimatedTaxPayment[]
  // One row per tax year, not one per user: a 1098-T is a statement about a
  // particular year, and reusing last year's figures in this year's estimate
  // is simply wrong. Query these with `where: { taxYear }`.
  form1098T         Form1098T[]
  form1098E         Form1098E[]
  homeOffice        HomeOfficeDeduction[]
}

model IncomeSource {
  id     String @id @default(cuid())
  name   String
  type   String // "Freelance", "Delivery", "Other"
  userId String
  user   User   @relation(fields: [userId], references: [id])

  transactions Transaction[]
  mileageLogs  MileageLog[]
}

/// Business miles driven, logged by the user. Schedule C Part IV.
///
/// Mileage is never inferred from income — the old dashboard multiplied
/// deposits by 0.25 and presented the result as real. A deduction requires
/// actual logged trips, which is what this table holds.
model MileageLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Trip date. This decides the rate: the IRS standard mileage rate can
  /// change mid-year, which is why mileageRateOn() in src/lib/tax/mileage.ts
  /// takes a date rather than just a tax year.
  date DateTime

  /// Miles driven. Decimal for the same reason money is — odometer readings
  /// carry tenths, and summing floats drifts.
  miles Decimal @db.Decimal(10, 2)

  /// Business purpose of the trip. Schedule C Part IV expects one, and the
  /// IRS requires contemporaneous records to substantiate the deduction.
  purpose String?

  incomeSourceId String?
  incomeSource   IncomeSource? @relation(fields: [incomeSourceId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Transaction {
  id             String        @id @default(cuid())
  // Money is DECIMAL(12,2), never Float: binary floats cannot hold cents
  // exactly. Prisma returns Prisma.Decimal; see src/lib/tax/money.ts.
  amount         Decimal       @db.Decimal(12, 2)
  type           String // "Income", "Expense"
  date           DateTime
  description    String?
  // DERIVED from `category` by the API on every write (an expense in a
  // Schedule C category; isDeductibleExpenseCategory). Never read by the tax
  // engine and never set from a request body; kept for the CSV export and
  // legacy readers. Migration 20260916000000 reconciled existing rows.
  taxDeductible  Boolean       @default(false)
  // Tax treatment, one of the keys in src/lib/tax/categories.ts, and the ONLY
  // thing that decides it. Null means not yet categorised: income defaults to
  // business income, an expense to personal (not deducted), each with a
  // warning in the estimate. Replaces matching on description text.
  category       String?
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  incomeSourceId String?
  incomeSource   IncomeSource? @relation(fields: [incomeSourceId], references: [id])

  // Plaid's transaction_id. Null for manually entered transactions.
  // Unique so re-running a sync updates rather than duplicates — without this,
  // every sync re-inserted the whole page of results.
  plaidTransactionId String? @unique

  @@index([userId, date])
}

model PlaidConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  accessToken String
  itemId      String
  cursor      String? // Used by Plaid to track sync state
  createdAt   DateTime @default(now())
}

model Form1098T {
  id                               String   @id @default(cuid())
  userId                           String
  user                             User     @relation(fields: [userId], references: [id])
  /// The year the statement covers. Box 1 and Box 5 are year-specific.
  taxYear                          Int
  box1                             Decimal  @db.Decimal(12, 2) // Tuition & Related Expenses
  box5                             Decimal  @db.Decimal(12, 2) // Scholarships & Grants
  /// The part of Box 5 that the grant's own terms earmark for living costs
  /// (room, board, travel). Always taxable, whatever tuition was paid. The
  /// name matches what the tax adapter already reads.
  restrictedToNonQualifiedExpenses Decimal  @default(0) @db.Decimal(12, 2)
  createdAt                        DateTime @default(now())

  @@unique([userId, taxYear])
}

/// One W-2 from an employer, for one tax year. Someone with several jobs has
/// several. Wages are how a day job reaches the estimate: a paycheck deposit is
/// deliberately not counted as income (category `w2_paycheck`), because the
/// W-2's boxes, not the net deposit, are what the return uses.
model W2Form {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  taxYear  Int
  /// What the user calls this job. Display only.
  employer String

  /// Box 1: wages, tips, other compensation. Form 1040 line 1a.
  wages               Decimal @db.Decimal(12, 2)
  /// Box 2: federal income tax withheld. Form 1040 line 25a.
  federalWithheld     Decimal @default(0) @db.Decimal(12, 2)
  /// Box 3: Social Security wages. With box 7, Schedule SE line 8a.
  socialSecurityWages Decimal @db.Decimal(12, 2)
  /// Box 7: Social Security tips.
  socialSecurityTips  Decimal @default(0) @db.Decimal(12, 2)
  /// Box 5: Medicare wages and tips. Form 8959.
  medicareWages       Decimal @db.Decimal(12, 2)
  /// Box 6: Medicare tax withheld. Above 1.45% of box 5 it is Additional
  /// Medicare Tax withholding (Form 8959 Part V).
  medicareWithheld    Decimal @default(0) @db.Decimal(12, 2)

  /// Joint returns only: whether this is the W-2 of the person with the side
  /// business. Schedule SE is per individual, so a spouse's wages must never
  /// reduce the self-employed spouse's Social Security base.
  ownedByTaxpayer Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId, taxYear])
}

/// An estimated tax payment sent to the IRS (Form 1040-ES), counted on Form
/// 1040 line 26. Attributed by `taxYear`, not by date: the fourth quarterly
/// payment for a year is due in January of the next.
model EstimatedTaxPayment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taxYear   Int
  paidOn    DateTime
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, taxYear])
}

model Form1098E {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// The year the interest was paid. The §221 deduction is annual.
  taxYear   Int
  box1      Decimal  @db.Decimal(12, 2) // Student Loan Interest Paid
  createdAt DateTime @default(now())

  @@unique([userId, taxYear])
}

model HomeOfficeDeduction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  /// Rent, utilities and the space itself all change between years.
  taxYear         Int
  totalSqFt       Decimal  @db.Decimal(12, 2)
  officeSqFt      Decimal  @db.Decimal(12, 2)
  rentAmount      Decimal  @db.Decimal(12, 2)
  utilitiesAmount Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@unique([userId, taxYear])
}
